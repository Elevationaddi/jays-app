{
  "name": "@jays/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL migrations (plain SQL, forward-only) and the migration runner.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node dist/cli.js"
  },
  "dependencies": {
    "@jays/config": "workspace:*",
    "kysely": "^0.29.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0"
  }
}
