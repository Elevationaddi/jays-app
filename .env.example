# Copy to .env for local development. Every value here is a fictional local placeholder.
# Real secrets are never committed; production refuses any value containing "local-dev-only".
# Schema and rules: packages/config/src/env.ts, docs/adr/0006-environment-and-secrets.md

APP_ENV=local
LOG_LEVEL=info

# Infrastructure (docker compose: pnpm dev:deps)
DATABASE_URL=postgresql://jays:jays@localhost:5432/jays
# Local only: rate limits. On Vercel they are counted in PostgreSQL instead, so no Redis subscription
# is needed in staging or production (ADR-0024, ADR-0033).
REDIS_URL=redis://localhost:6379
# Vercel (ADR-0033): RATE_LIMIT_STORE=postgres (no Redis), SCHEDULERS=off (jobs from the cron
# routes, which need CRON_SECRET), DB_POOL_MAX=3. Locally: Redis, timers and the worker.
RATE_LIMIT_STORE=redis
SCHEDULERS=on
# CRON_SECRET=
# DB_POOL_MAX=10

# API
API_PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081

# Auth (ADR-0009). JWT_KEYS is kid:secret[,kid:secret]; the first key signs, all keys verify.
JWT_KEYS=local1:local-dev-only-change-me-0000000000000000
# HMAC key for one-time codes and key material for encrypting admin TOTP secrets.
OTP_SECRET=local-dev-only-otp-secret-change-me-00000000
MFA_ENCRYPTION_KEY=local-dev-only-mfa-key-change-me-0000000000
# Admin console base URL for invitation links.
ADMIN_WEB_URL=http://localhost:3002
BUSINESS_WEB_URL=http://localhost:3001
# Reverse proxies in front of the API (client IPs for rate limits). 0 locally.
TRUST_PROXY_HOPS=0
# Email: Resend Free in phase 9 (ADR-0024). There is no SMS provider: SMS is not part of the release,
# and the mock (which prints codes to the API log) is for local development only.
# Email: mock locally; resend in staging and production (ADR-0031). No SMS provider exists.
NOTIFY_PROVIDER=mock
EMAIL_FROM=
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
# Push: none, mock (local only) or fcm with FCM_SERVICE_ACCOUNT_JSON (one line).
PUSH_PROVIDER=mock
FCM_SERVICE_ACCOUNT_JSON=

# Web portals call the API from their servers (never from the browser).
API_URL=http://localhost:3000/v1

# Object storage (ADR-0012, ADR-0032): local or supabase. Locally, files go to STORAGE_LOCAL_DIR
# (relative to apps/api when started with pnpm --filter) and the API serves HMAC-signed URLs.
# With supabase, set SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (server side only) in Vercel.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=jays-local
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.local-storage
STORAGE_SIGNING_SECRET=local-dev-only-storage-signing-change-me-000
# Public base URL of the API, used in signed upload/download URLs.
API_PUBLIC_URL=http://localhost:3000/v1
# Malware scanning of uploads: mock (flags the EICAR test file only; refused in production) or
# clamav (clamd INSTREAM; TLS required in production). Fails closed when the scanner is down.
MALWARE_SCANNER=mock
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TLS=true
# Delivery partner (ADR-0029): none (businesses enter tracking) or mock (local only).
DELIVERY_PARTNER=mock

# Payments: only the mock provider exists until phase 5
PSP_PROVIDER=mock
# Stripe test mode only (ADR-0030): sk_test_ / pk_test_ keys; live keys are refused.
PSP_API_KEY=
PSP_PUBLISHABLE_KEY=
PSP_CONNECT_WEBHOOK_SECRET=
PSP_WEBHOOK_SECRET=local-dev-only-webhook-secret
# Development switch that lets you pick mock payment outcomes (success/fail/timeout/duplicate).
# Refused when APP_ENV=production.
MOCK_PAYMENT_OUTCOMES=true

# Private staging (ADR-0035). Required with APP_ENV=staging: the API gate token (also set on the
# portals, and as EXPO_PUBLIC_STAGING_ACCESS_TOKEN on the staging web build), invite-only sign-up
# and no verification document uploads. Locally sign-up is open and uploads use the mock scanner.
# STAGING_ACCESS_TOKEN=
SIGNUP_MODE=open
# SIGNUP_ALLOWLIST=tester@example.test,@demo.jays.example
DOCUMENT_UPLOADS=enabled

# Optional. No paid maps service is planned (ADR-0024); MAPS_KEY stays empty.
MAPS_KEY=
EMAIL_KEY=

# Prometheus scrape token for GET /v1/metrics (ADR-0017). Empty disables the endpoint locally;
# production requires a real value of at least 32 characters.
METRICS_TOKEN=
