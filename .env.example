# Copy to .env for local development. Every value here is a fictional local placeholder.
# Real secrets are never committed; production refuses any value containing "local-dev-only".
# Schema and rules: packages/config/src/env.ts, docs/adr/0006-environment-and-secrets.md

APP_ENV=local
LOG_LEVEL=info

# Infrastructure (docker compose: pnpm dev:deps)
DATABASE_URL=postgresql://jays:jays@localhost:5432/jays
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081

# Auth (ADR-0009). JWT_KEYS is kid:secret[,kid:secret]; the first key signs, all keys verify.
JWT_KEYS=local1:local-dev-only-change-me-0000000000000000
# HMAC key for one-time codes and key material for encrypting admin TOTP secrets.
OTP_SECRET=local-dev-only-otp-secret-change-me-00000000
MFA_ENCRYPTION_KEY=local-dev-only-mfa-key-change-me-0000000000
# Admin console base URL for invitation links.
ADMIN_WEB_URL=http://localhost:3002
# Reverse proxies in front of the API (client IPs for rate limits). 0 locally.
TRUST_PROXY_HOPS=0
# Email/SMS: only the mock exists until a provider is chosen. It prints codes to the API log.
NOTIFY_PROVIDER=mock

# Web portals call the API from their servers (never from the browser).
API_URL=http://localhost:3000/v1

# Object storage (ADR-0012). Only the local adapter exists so far: files go to STORAGE_LOCAL_DIR
# (relative to apps/api when started with pnpm --filter) and the API serves HMAC-signed URLs.
STORAGE_BUCKET=jays-local
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.local-storage
STORAGE_SIGNING_SECRET=local-dev-only-storage-signing-change-me-000
# Public base URL of the API, used in signed upload/download URLs.
API_PUBLIC_URL=http://localhost:3000/v1
# Malware scanning of uploads. The mock flags the EICAR test file only.
MALWARE_SCANNER=mock

# Payments: only the mock provider exists until phase 5
PSP_PROVIDER=mock
PSP_API_KEY=
PSP_WEBHOOK_SECRET=local-dev-only-webhook-secret
# Development switch that lets you pick mock payment outcomes (success/fail/timeout/duplicate).
# Refused when APP_ENV=production.
MOCK_PAYMENT_OUTCOMES=true

# Optional locally (mock adapters are used when empty); required in production
MAPS_KEY=
EMAIL_KEY=
