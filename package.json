{
  "name": "jays-app",
  "version": "0.0.0",
  "private": true,
  "description": "UAE dual marketplace: shop beauty and lifestyle products, book in-venue beauty and wellness services.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi": "pnpm --filter @jays/api openapi",
    "openapi:check": "pnpm --filter @jays/api openapi && git diff --exit-code -- apps/api/openapi.json",
    "dev:deps": "docker compose up -d --wait postgres redis",
    "dev:deps:down": "docker compose down",
    "db:migrate": "pnpm --filter @jays/db migrate",
    "db:seed": "pnpm --filter @jays/api build && pnpm --filter @jays/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "axe-core": "4.11.0",
    "eslint": "^10.16.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
