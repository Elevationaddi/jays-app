# Staging configuration. Copy to staging.env (gitignored) and replace every CHANGE_ME value with a
# secret from the secret manager. Example values are refused by production on purpose.
APP_ENV=staging
LOG_LEVEL=info
DATABASE_URL=postgresql://jays:CHANGE_ME@postgres:5432/jays
REDIS_URL=redis://redis:6379

API_PORT=3000
API_URL=http://api:3000/v1
API_PUBLIC_URL=https://api.staging.example.test/v1
ADMIN_WEB_URL=https://admin.staging.example.test
CORS_ORIGINS=https://business.staging.example.test,https://admin.staging.example.test
TRUST_PROXY_HOPS=1

JWT_KEYS=staging1:CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
OTP_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
MFA_ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
STORAGE_SIGNING_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
PSP_WEBHOOK_SECRET=CHANGE_ME_AT_LEAST_16
METRICS_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS

# Mock adapters until the founder decisions on PSP (D5) and email/SMS (D14) are made.
PSP_PROVIDER=mock
NOTIFY_PROVIDER=mock
STORAGE_PROVIDER=local
STORAGE_BUCKET=jays-staging
MALWARE_SCANNER=mock
MOCK_PAYMENT_OUTCOMES=false
