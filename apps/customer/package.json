{
  "name": "@jays/customer",
  "version": "0.0.0",
  "private": true,
  "description": "Customer mobile app (Expo React Native): shop products and book services.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "export:web": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@jays/api-client": "workspace:*",
    "@jays/contracts": "workspace:*",
    "@jays/domain": "workspace:*",
    "@jays/i18n": "workspace:*",
    "@jays/ui": "workspace:*",
    "expo": "~58.1.0",
    "expo-document-picker": "~58.0.5",
    "expo-location": "~58.0.23",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@jays/config": "workspace:*",
    "@types/react": "~19.3.0"
  }
}
