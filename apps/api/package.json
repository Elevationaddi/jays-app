{
  "name": "@jays/api",
  "version": "0.0.0",
  "private": true,
  "description": "REST API (/v1): the single source of truth for identity, tenancy, money and state.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "node --watch --env-file-if-exists=../../.env dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi": "tsc -p tsconfig.build.json && node dist/scripts/openapi.js",
    "seed": "node --env-file-if-exists=../../.env dist/scripts/seed.js",
    "totp": "node --env-file-if-exists=../../.env dist/scripts/totp.js",
    "admin:bootstrap": "node --env-file-if-exists=../../.env dist/scripts/admin-bootstrap.js"
  },
  "dependencies": {
    "@jays/config": "workspace:*",
    "@jays/contracts": "workspace:*",
    "@jays/db": "workspace:*",
    "@jays/domain": "workspace:*",
    "@jays/i18n": "workspace:*",
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/swagger": "^12.1.3",
    "@node-rs/argon2": "^2.2.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "kysely": "^0.29.9",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.3",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "unplugin-swc": "^2.0.0"
  }
}
