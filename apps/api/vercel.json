{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @jays/api build",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    { "path": "/v1/internal/cron/minute", "schedule": "* * * * *" },
    { "path": "/v1/internal/cron/five-minutes", "schedule": "*/5 * * * *" },
    { "path": "/v1/internal/cron/hourly", "schedule": "7 * * * *" }
  ]
}
